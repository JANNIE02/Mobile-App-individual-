From 9e0dff455c4f05ba303f16d7f45acab9b50a3cd2 Mon Sep 17 00:00:00 2001
From: Jann <birungi.jannie@strathmore.edu>
Date: Sun, 15 Nov 2026 08:22:47 +0300
Subject: [PATCH] Fix build and launch errors

- Remove stray res/activity_main.xml (belongs only in res/layout)
- Add Material Components dependency (MaterialToolbar, NavigationView)
- Use Material3 NoActionBar theme (required by AppCompat/Material widgets)
- Register LoginActivity (launcher) and RegisterActivity in the manifest

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PiBPVAFKQ7AgSh826rAPek
---
 TenantManagementSystem/app/build.gradle.kts   |   1 +
 .../app/src/main/AndroidManifest.xml          |  14 +-
 .../app/src/main/res/activity_main.xml        | 131 ------------------
 .../app/src/main/res/values/themes.xml        |   2 +-
 4 files changed, 13 insertions(+), 135 deletions(-)
 delete mode 100644 TenantManagementSystem/app/src/main/res/activity_main.xml

diff --git a/TenantManagementSystem/app/build.gradle.kts b/TenantManagementSystem/app/build.gradle.kts
index 5b85279..992619b 100644
--- a/TenantManagementSystem/app/build.gradle.kts
+++ b/TenantManagementSystem/app/build.gradle.kts
@@ -41,6 +41,7 @@ android {
 dependencies {
     implementation("androidx.appcompat:appcompat:1.7.1")
     implementation("androidx.constraintlayout:constraintlayout:2.2.1")
+    implementation("com.google.android.material:material:1.12.0")
     implementation("androidx.navigation:navigation-fragment-ktx:2.9.8")
     implementation("androidx.navigation:navigation-ui-ktx:2.9.8")
     implementation(platform(libs.androidx.compose.bom))
diff --git a/TenantManagementSystem/app/src/main/AndroidManifest.xml b/TenantManagementSystem/app/src/main/AndroidManifest.xml
index b47bb62..f8c7bd3 100644
--- a/TenantManagementSystem/app/src/main/AndroidManifest.xml
+++ b/TenantManagementSystem/app/src/main/AndroidManifest.xml
@@ -12,10 +12,8 @@
         android:supportsRtl="true"
         android:theme="@style/Theme.TenantManagementSystem">
         <activity
-            android:name=".MainActivity"
+            android:name=".LoginActivity"
             android:exported="true"
-            android:label="@string/app_name"
-            android:theme="@style/Theme.TenantManagementSystem"
             android:windowSoftInputMode="adjustResize">
             <intent-filter>
                 <action android:name="android.intent.action.MAIN" />
@@ -23,6 +21,16 @@
                 <category android:name="android.intent.category.LAUNCHER" />
             </intent-filter>
         </activity>
+
+        <activity
+            android:name=".RegisterActivity"
+            android:exported="false" />
+
+        <activity
+            android:name=".MainActivity"
+            android:exported="false"
+            android:label="@string/app_name"
+            android:windowSoftInputMode="adjustResize" />
     </application>
 
 </manifest>
\ No newline at end of file
